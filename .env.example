# =============================================
# DOCE LEVEZA — Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores
# NUNCA commit o arquivo .env (já está no .gitignore)

# ----- BANCO DE DADOS (Turso / LibSQL) -----
# URL do banco Turso (formato: libsql://nome-db-org.turso.io)
TURSO_DATABASE_URL=libsql://seu-banco-org.turso.io

# Token de autenticação do Turso
TURSO_AUTH_TOKEN=seu_token_turso_aqui

# ----- SESSÃO (Iron Session) -----
# Senha da sessão — mínimo 32 caracteres, aleatória e segura
SESSION_PASSWORD=use_uma_senha_aleatoria_longa_e_segura_aqui_minimo_32_chars

# ----- AMBIENTE -----
NODE_ENV=production
