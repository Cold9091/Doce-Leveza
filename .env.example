# Supabase PostgreSQL Connection
# NOTE: some environments (e.g. dev container) cannot reach the
# IPv6 address returned by Supabase DNS.  If you see an ENETUNREACH
# error, replace the hostname with its IPv4 address or add
# `?hostaddr=<ipv4>` to the end of the URL.
DATABASE_URL=postgresql://postgres:your_password@db.supabase.co:5432/postgres

# Session Secret for Iron Session
SESSION_SECRET=your_random_session_secret_here

# Session
SESSION_SECRET=your_session_secret_key_here
SESSION_PASSWORD=complex_password_at_least_32_characters_long_and_secure

# Environment
NODE_ENV=production
