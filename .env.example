# Configure with your Supabase database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@host.supabase.co:5432/postgres
SESSION_SECRET=your_random_session_secret_here

# Session
SESSION_SECRET=your_session_secret_key_here
SESSION_PASSWORD=complex_password_at_least_32_characters_long_and_secure

# Environment
NODE_ENV=production
